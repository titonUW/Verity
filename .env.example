# Verity Platform Configuration

# ============================================================================
# Database
# ============================================================================
DATABASE_URL=postgresql://verity:verity_dev_password@localhost:5432/verity

# ============================================================================
# Redis
# ============================================================================
REDIS_URL=redis://localhost:6379

# ============================================================================
# API Server
# ============================================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Inference service URL
INFERENCE_URL=http://localhost:8000

# Security (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
API_KEY_SALT=your-api-key-salt-min-16

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# File size limits
MAX_FILE_SIZE_MB=100

# Enable Swagger docs
ENABLE_SWAGGER=true

# ============================================================================
# Inference Service
# ============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# Model configuration
ENABLE_GPU=false
MODEL_CACHE_DIR=/app/models

# Feature flags
ENABLE_IMAGE_DETECTION=true
ENABLE_VIDEO_DETECTION=true
ENABLE_AUDIO_DETECTION=true
ENABLE_TEXT_DETECTION=true
ENABLE_NSFW_DETECTION=true
ENABLE_DEEPFAKE_DETECTION=false
ENABLE_C2PA=true
ENABLE_WATERMARK_DETECTION=false

# HuggingFace model IDs
CLIP_MODEL_ID=openai/clip-vit-base-patch32
NSFW_MODEL_ID=Falconsai/nsfw_image_detection

# ============================================================================
# Web Application
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3000
