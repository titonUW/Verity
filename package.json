{
  "name": "verity",
  "version": "0.1.0",
  "description": "Trust infrastructure for digital content - Verifies reality before decisions are made",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/*/src/**/*.ts",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "demo": "npm run build && node scripts/demo.mjs",
    "clean": "rm -rf packages/*/dist"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.10.0",
    "@types/unzipper": "^0.10.11",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Verity Team",
  "license": "MIT"
}
